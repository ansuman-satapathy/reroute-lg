{
  "name": "logistics-disruption-triage",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous Supply-Chain Disruption Triage Agent powered by TrueForge",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "mcp-servers/*"
  ],
  "scripts": {
    "db:init": "tsx db/init-db.ts",
    "db:verify": "tsx db/verify-db.ts",
    "dev:erp": "tsx mcp-servers/erp/src/index.ts",
    "test:erp": "tsx mcp-servers/erp/test-tools.ts",
    "dev:telemetry": "tsx mcp-servers/telemetry/src/index.ts",
    "test:telemetry": "tsx mcp-servers/telemetry/test-tools.ts",
    "start:mcp": "tsx scripts/start-mcp-servers.ts",
    "config:agent": "tsx trueforge/agent-config.ts",
    "test:agent": "tsx trueforge/test-agent.ts",
    "inject-alert": "tsx scripts/inject-alert.ts",
    "test:inject-alert": "tsx test/test-inject-alert.ts",
    "test:skill": "tsx test/test-skill-routing.ts",
    "test:subagents": "tsx test/test-subagents.ts",
    "test:optimization": "tsx test/test-cost-optimization.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
