# ===================================================
# Logistics Disruption Triage Agent - Environment Config
# ===================================================

# TrueForge Agent Harness URL
TRUEFORGE_BASE_URL=http://localhost:8790

# Optional: Bearer token if OIDC auth is enabled in TrueForge
# TRUEFORGE_TOKEN=

# Agent Name in TrueForge
TRUEFORGE_AGENT_NAME=disruption-triage-agent

# SQLite Database Location
DATABASE_PATH=./data/erp.db

# MCP Server Connector URLs (Used by TrueForge to reach MCP endpoints)
# Defaults to localhost; override if TrueForge is deployed in a remote or containerized environment
ERP_MCP_PORT=3001
ERP_MCP_URL=http://localhost:3001/sse
TELEMETRY_MCP_PORT=3002
TELEMETRY_MCP_URL=http://localhost:3002/sse
